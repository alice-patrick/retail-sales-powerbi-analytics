	partition FactTargets = m
		mode: import
		source =
				let
				    CompressedCSV = Binary.FromText("", BinaryEncoding.Base64),
				    Source = Csv.Document(Binary.Decompress(CompressedCSV, Compression.Deflate), [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"MonthStart", type date}, {"RegionID", Int64.Type}, {"ChannelID", Int64.Type}, {"SalesTarget", type number}, {"ProfitTarget", type number}}, "en-US")
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

