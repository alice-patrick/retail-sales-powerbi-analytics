		lineageTag: 2f9b4d8b-52b3-5266-b854-448b4a476bf6

	measure '2026 YTD Revenue' = CALCULATE([Net Revenue], DATESBETWEEN(DimDates[Date], DATE(2026,1,1), DATE(2026,9,30)))
